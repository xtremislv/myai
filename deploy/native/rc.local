#!/bin/sh
# Install as /etc/rc.local: the container runs it at every start (before /root/onstart.sh, which
# the provider manages). See docs/SERVER_SETUP.md, "Auto-start".
# PID files from before the restart point at processes that no longer exist (and their numbers
# may now belong to others), so drop them, then start everything in the background;
# start_native.sh also starts scripts/watchdog.sh, which emails the admin the new links.
rm -f /var/log/ai-platform/*.pid
mkdir -p /var/log/ai-platform
# The watchdog emails the admin once everything is back up after this start, then deletes the file.
date -u '+%Y-%m-%d %H:%M UTC' > /var/log/ai-platform/boot.pending
setsid nohup /root/myai/scripts/start_native.sh >> /var/log/ai-platform/boot.log 2>&1 < /dev/null &
