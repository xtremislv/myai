# Copy to .env and fill in. Generate the vault key:
#   python -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())"

ENVIRONMENT=dev

# The gateway refuses to start with a missing or placeholder JWT_SECRET or
# VAULT_MASTER_KEY. Any ENVIRONMENT other than "dev" also rejects the default
# Postgres and MinIO passwords below.

# auth (at least 32 characters). Generate:
#   python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET=please-change-this-to-a-long-random-string

# vLLM — pick ONE model.
LLM_BASE_URL=http://vllm:8001/v1

# Default: 26B / A4B MoE (~4B active params per token). Replace with the exact
# Hugging Face repo id for your weights.
LLM_MODEL=gemma-3-26b-a4b-it

# To switch to NVIDIA Nemotron instead, comment the line above and use e.g.:
# LLM_MODEL=nvidia/Nemotron-... (set the exact repo id)
# Nemotron weights usually need a HF token:
# HUGGING_FACE_HUB_TOKEN=hf_...

# Postgres (keep the password in POSTGRES_DSN equal to POSTGRES_PASSWORD)
POSTGRES_PASSWORD=ai
POSTGRES_DSN=postgresql://ai:ai@postgres:5432/ai_platform

# Redis
REDIS_URL=redis://redis:6379/0

# MinIO
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=ai-platform
MINIO_SECURE=false

# Vault master key (REQUIRED, 32 bytes base64)
VAULT_MASTER_KEY=

# Grafana admin login
GRAFANA_PASSWORD=admin

# Observability
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
OTEL_SERVICE_NAME=ai-platform-gateway
