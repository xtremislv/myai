# Copy to .env and fill in. Generate the vault key:
#   python -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())"

ENVIRONMENT=dev

# The gateway refuses to start with a missing or placeholder JWT_SECRET or
# VAULT_MASTER_KEY. Any ENVIRONMENT other than "dev" also rejects the default
# Postgres and MinIO passwords below.

# auth (at least 32 characters). Generate:
#   python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET=please-change-this-to-a-long-random-string

# vLLM — pick ONE model. Without Docker (scripts/run_vllm.sh) use http://127.0.0.1:8001/v1.
LLM_BASE_URL=http://vllm:8001/v1

# Default: Gemma 4 26B-A4B MoE (~4B active params per token). This is the name the gateway
# asks vLLM for. The full bf16 weights are ~52 GB; on a 48 GB card use an INT4 (AWQ/GPTQ) copy
# and point VLLM_MODEL_PATH at it, or set LLM_MODEL to that copy's repo id.
LLM_MODEL=google/gemma-4-26B-A4B-it
# Local weights directory, used by scripts/run_vllm.sh (no Docker). Empty: download LLM_MODEL.
VLLM_MODEL_PATH=

# To switch to NVIDIA Nemotron instead, comment the line above and use e.g.:
# LLM_MODEL=nvidia/Nemotron-... (set the exact repo id)
# Nemotron weights usually need a HF token:
# HUGGING_FACE_HUB_TOKEN=hf_...

# Postgres (keep the password in POSTGRES_DSN equal to POSTGRES_PASSWORD)
POSTGRES_PASSWORD=ai
POSTGRES_DSN=postgresql://ai:ai@postgres:5432/ai_platform

# Redis
REDIS_URL=redis://redis:6379/0

# MinIO
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=ai-platform
MINIO_SECURE=false

# Vault master key (REQUIRED, 32 bytes base64)
VAULT_MASTER_KEY=

# Flags for vLLM. These depend on the card and the weights (docs/SERVER_SETUP.md, step 5).
# Turing (Quadro RTX 8000) needs --dtype half: vLLM refuses bfloat16 below compute capability 8.0.
# Quantization (AWQ/GPTQ) is read from the checkpoint's config, so --quantization is optional.
# Gemma 4 agents use native function calling: --enable-auto-tool-choice --tool-call-parser gemma4.
VLLM_EXTRA_ARGS=--dtype half --enable-auto-tool-choice --tool-call-parser gemma4

# Web addresses for the Caddy proxy
DOMAIN=
GRAFANA_DOMAIN=

# Backups: an rclone destination. Empty means backups stay on this server.
BACKUP_DEST=
BACKUP_KEEP_DAYS=7

# Grafana admin login
GRAFANA_PASSWORD=admin

# Prometheus sends alerts to the gateway with this bearer token; they appear under the admin's
# bell. Any long random string: python -c "import secrets;print(secrets.token_urlsafe(32))"
ALERT_WEBHOOK_TOKEN=

# Observability
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
OTEL_SERVICE_NAME=ai-platform-gateway
# false on native hosts: Alloy has no trace backend and rejects traces.
OTEL_TRACES_EXPORT=true

# Outbound proxy for the agents' web access (pages, search APIs, browser). Empty = direct.
# With an SSH tunnel to your own VPS (PROXY_SSH below): OUTBOUND_PROXY=socks5h://127.0.0.1:1080
OUTBOUND_PROXY=
# The company's own YouTube channels (id=name), known to the agents as "ours". API key: vault secret youtube/api.
# Brand stores for gadget_search, name=url,... (empty = built-in list; web:https://... = web search only).
GADGET_STORES=
YOUTUBE_OWN_CHANNELS=UCdp6GUwjKscp5ST4M4WgIpw=TechWiser,UCakfrdHa0lItW8e5qpZd5lA=GadgetWiser
# user@host of a server to tunnel through; start_native.sh keeps the tunnel up. Key: PROXY_SSH_KEY.
PROXY_SSH=
PROXY_SSH_PORT=22
PROXY_SSH_KEY=/root/.ssh/proxy_vps
