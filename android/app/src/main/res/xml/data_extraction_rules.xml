<?xml version="1.0" encoding="utf-8"?>
<!-- The sign-in (refresh token, sealed by the Android Keystore) never leaves the phone: a backup
     restored elsewhere couldn't decrypt it anyway. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="tw_secure.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="tw_secure.xml" />
    </device-transfer>
</data-extraction-rules>
